# Copy to infra/.env and fill in the blank secrets before running Compose.
# Generate each new secret independently with: openssl rand -hex 32
# Preserve an existing secure JWT key and issuer when upgrading a deployment.
QARI_JWT_SECRET_KEY=
QARI_JWT_ALGORITHM=HS256
QARI_JWT_ISSUER=qari-core-api

# Must match the password already configured in an existing Postgres volume.
QARI_POSTGRES_PASSWORD=
# Replace <URL-encoded-password> with the percent-encoded database password.
QARI_DATABASE_URL=postgresql+asyncpg://qari:<URL-encoded-password>@postgres:5432/qari

QARI_CORS_ORIGINS='["https://qari.pneumetron.com"]'
QARI_RECITATION_API_PUBLIC_URL=https://qari.pneumetron.com
QARI_MODELS_DIR=../models
