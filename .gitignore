mobile/coverage/
mobile/.fvm/

# ML model weights (large, stored separately)
ml/models/
# Converted Faster-Whisper (CTranslate2) live-ASR model — build via
# scripts/convert_tarteel_model.py; never commit (gitignored like reference_data).
backend/recitation_api/models/
*.onnx
*.pt
*.bin
*.safetensors

# Secrets
*.pem
*.key
secrets/
infra/certs/
# ...except the CA cert embedded in the app (needed to trust the self-signed backend)
!mobile/android/app/src/main/res/raw/qari_ca.pem

# Docker
infra/data/
infra/docker-compose.override.yml

# Generated recitation reference bundle (regenerate via scripts/build_reference_from_local_corpus.py)
backend/recitation_api/reference_data/

# Release signing (do not commit)
mobile/android/upload-keystore.jks
mobile/android/key.properties

# Release APKs (build artifacts, ~75MB each — serve them, don't version them)
releases/
*.apk
*.aab

# Trained model weights and tokenizers (large; see ml/models/ in .gitignore)
models/
